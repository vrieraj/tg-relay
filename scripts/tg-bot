#!/usr/bin/env python3
"""Telegram relay daemon: multi-session, voice/text, Kokoro TTS (local)."""
import json, os, re, signal, sys, threading, time, uuid
from datetime import datetime
import requests

ENV_FILE = os.environ.get("TG_RELAY_ENV_FILE") or os.path.expanduser("~/.config/opencode/.env")
cfg = {}
if os.path.exists(ENV_FILE):
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                cfg[k] = v

TOKEN = os.environ.get("TG_TOKEN") or cfg.get("TG_TOKEN") or ""
CHAT_ID = os.environ.get("TG_CHAT_ID") or cfg.get("TG_CHAT_ID") or ""
GROQ_KEY = os.environ.get("GROQ_API_KEY") or cfg.get("GROQ_API_KEY") or ""
BASE = os.environ.get("TG_RELAY_SESSIONS") or os.path.expanduser("~/Proyectos/tg-relay/sessions")
STATE_FILE = "/tmp/tg-last-update"
CURRENT_FILE = "/tmp/tg-current-session"
CURRENT = ""
if os.path.exists(CURRENT_FILE):
    with open(CURRENT_FILE) as f:
        CURRENT = f.read().strip()
if not CURRENT:
    CURRENT = os.environ.get("TG_CURRENT_SESSION") or ""

if not TOKEN or not CHAT_ID:
    print("ERROR: TG_TOKEN and TG_CHAT_ID are required", file=sys.stderr)
    sys.exit(1)

MAX_FILE_SIZE = 50 * 1024 * 1024
SESSION_NAME_RE = re.compile(r'^[a-zA-Z0-9_-]+$')

def send_text(text):
    resp = requests.post(f"https://api.telegram.org/bot{TOKEN}/sendMessage",
                         json={"chat_id": CHAT_ID, "text": text})
    data = resp.json()
    if not data.get("ok"):
        print(f"[send_text] Telegram API error: {data.get('description', 'unknown')}", file=sys.stderr)

def send_audio(file_path):
    with open(file_path, "rb") as f:
        resp = requests.post(f"https://api.telegram.org/bot{TOKEN}/sendAudio",
                             data={"chat_id": CHAT_ID}, files={"audio": f})
    data = resp.json()
    if not data.get("ok"):
        print(f"[send_audio] Telegram API error: {data.get('description', 'unknown')}", file=sys.stderr)

def transcribe_groq(file_path):
    with open(file_path, "rb") as f:
        resp = requests.post(
            "https://api.groq.com/openai/v1/audio/transcriptions",
            headers={"Authorization": f"Bearer {GROQ_KEY}"},
            data={"model": "whisper-large-v3-turbo"},
            files={"file": f},
        )
    if not resp.ok:
        print(f"[transcribe_groq] API error: {resp.status_code} {resp.text}", file=sys.stderr)
        return ""
    data = resp.json()
    return data.get("text", "")

def tts_kokoro(text):
    from kokoro import KPipeline
    import soundfile as sf
    pipeline = KPipeline(lang_code='e')
    audio_out = []
    for gs, ps, audio in pipeline(text, voice='ef_dora', speed=0.85):
        audio_out.append(audio)
    if not audio_out:
        return None
    import numpy as np
    full = np.concatenate(audio_out)
    path = f"/tmp/tg-tts-{uuid.uuid4()}.wav"
    sf.write(path, full, 24000)
    return path

def get_updates(offset):
    resp = requests.get(f"https://api.telegram.org/bot{TOKEN}/getUpdates",
                        params={"offset": offset + 1, "timeout": 10}, timeout=15)
    data = resp.json()
    if not data.get("ok"):
        print(f"[get_updates] Telegram API error: {data.get('description', 'unknown')}", file=sys.stderr)
        return []
    return data.get("result", [])

def download_file(file_id):
    resp = requests.get(f"https://api.telegram.org/bot{TOKEN}/getFile",
                        params={"file_id": file_id})
    resp.raise_for_status()
    info = resp.json()
    path = info["result"]["file_path"]
    url = f"https://api.telegram.org/file/bot{TOKEN}/{path}"
    ext = path.rsplit('.', 1)[-1] if '.' in path else 'bin'
    dest = f"/tmp/tg-file-{uuid.uuid4()}.{ext}"
    dl = requests.get(url, stream=True)
    dl.raise_for_status()
    size = 0
    with open(dest, "wb") as f:
        for chunk in dl.iter_content(chunk_size=8192):
            size += len(chunk)
            if size > MAX_FILE_SIZE:
                os.remove(dest)
                raise ValueError(f"File too large (limit: {MAX_FILE_SIZE // (1024*1024)} MB)")
            f.write(chunk)
    return dest

def list_sessions():
    if not os.path.isdir(BASE):
        return []
    sessions = []
    for d in sorted(os.listdir(BASE)):
        if os.path.isdir(os.path.join(BASE, d)):
            sessions.append(d)
    return sessions

def format_sessions():
    if not os.path.isdir(BASE):
        return "(no sessions directory)"
    lines = []
    for d in sorted(os.listdir(BASE)):
        path = os.path.join(BASE, d)
        if not os.path.isdir(path):
            continue
        inbox = len(os.listdir(os.path.join(path, "inbox"))) if os.path.exists(os.path.join(path, "inbox")) else 0
        outbox = len(os.listdir(os.path.join(path, "outbox"))) if os.path.exists(os.path.join(path, "outbox")) else 0
        files_dir = os.path.join(path, "files")
        nfiles = len(os.listdir(files_dir)) if os.path.exists(files_dir) else 0
        cur = " ◀" if d == CURRENT else ""
        lines.append(f"  {d}{cur}  ({inbox} pendientes, {outbox} respuestas, {nfiles} archivos)")
    return "\n".join(lines) if lines else "(sin sesiones)"

def close_session_from_telegram(name):
    path = os.path.join(BASE, name)
    if not os.path.isdir(path):
        send_text(f"❌ Sesión '{name}' no encontrada")
        return
    files_dir = os.path.join(path, "files")
    saved = []
    if os.path.exists(files_dir) and os.listdir(files_dir):
        dest = os.path.expanduser(f"~/Descargas/tg-{name}-{datetime.now().strftime('%Y%m%d_%H%M%S')}")
        os.makedirs(dest, exist_ok=True)
        for f in os.listdir(files_dir):
            shutil.move(os.path.join(files_dir, f), os.path.join(dest, f))
        saved = [f"📁 {len(os.listdir(dest))} archivos guardados en {dest}"]
    import shutil
    shutil.rmtree(path)
    global CURRENT
    if CURRENT == name:
        CURRENT = ""
        if os.path.exists(CURRENT_FILE):
            os.remove(CURRENT_FILE)
    parts = saved
    parts.append(f"✅ Sesión '{name}' cerrada")
    remaining = list_sessions()
    if not remaining:
        parts.append("ℹ️ No quedan sesiones activas")
    send_text("\n".join(parts))

def write_to_inbox(session, text):
    mid = str(uuid.uuid4())[:8]
    in_file = os.path.join(BASE, session, "inbox", f"{mid}.txt")
    os.makedirs(os.path.dirname(in_file), exist_ok=True)
    with open(in_file, "w") as f:
        f.write(text)
    with open(os.path.join(BASE, session, ".new"), "w") as f:
        f.write(mid)
    estado_file = os.path.join(BASE, session, "!estado.txt")
    estado = "idle"
    if os.path.exists(estado_file):
        with open(estado_file) as f:
            estado = f.read().strip()
    if estado and estado != "idle":
        send_text(f"⏳ Estoy ocupado: {estado}\n📩 Tu mensaje queda en cola, lo proceso cuando termine.")

try:
    with open(STATE_FILE) as f:
        last_id = int(f.read().strip())
except (FileNotFoundError, ValueError):
    last_id = 0

def save_offset(uid):
    with open(STATE_FILE, "w") as f:
        f.write(str(uid))
    return uid

def cleanup(signum, frame):
    print(f"[tg-bot] Shutting down (signal {signum})...", file=sys.stderr)
    sys.exit(0)

signal.signal(signal.SIGTERM, cleanup)
signal.signal(signal.SIGINT, cleanup)

send_text(f"🔁 Relay activado | Sesión: {CURRENT or '(ninguna)'}")
send_text("Sesiones:\n" + format_sessions() if list_sessions() else "Sin sesiones activas")

def responder():
    while True:
        try:
            for ses in list_sessions():
                out_dir = os.path.join(BASE, ses, "outbox")
                if not os.path.isdir(out_dir):
                    continue
                for fname in sorted(os.listdir(out_dir)):
                    if not fname.endswith(".txt") or fname.endswith(".processing"):
                        continue
                    src = os.path.join(out_dir, fname)
                    dst = src + ".processing"
                    try:
                        os.rename(src, dst)
                    except FileNotFoundError:
                        continue
                    try:
                        with open(dst) as f:
                            reply = f.read().strip()
                        if reply:
                            if reply.startswith("!tts "):
                                audio_path = tts_kokoro(reply[5:])
                                if audio_path:
                                    send_audio(audio_path)
                                    os.remove(audio_path)
                            else:
                                send_text(reply)
                    finally:
                        if os.path.exists(dst):
                            os.remove(dst)
        except Exception as e:
            print(f"[responder] Error: {e}", file=sys.stderr)
        time.sleep(3)

threading.Thread(target=responder, daemon=True).start()

while True:
    try:
        updates = get_updates(last_id)
        for update in updates:
            uid = update["update_id"]

            msg = update.get("message") or update.get("edited_message") or {}
            is_edit = "edited_message" in update
            chat = msg.get("chat", {})
            if str(chat.get("id")) != CHAT_ID:
                last_id = save_offset(uid)
                continue

            text = msg.get("text", "")

            voice = msg.get("voice") or msg.get("audio") or {}
            if voice.get("file_id") and not is_edit:
                audio_path = download_file(voice["file_id"])
                send_text("🎤 Transcribiendo...")
                text = transcribe_groq(audio_path)
                os.remove(audio_path)
                send_text(f"📝 Transcripción: {text}")

            if not text:
                last_id = save_offset(uid)
                continue

            text_lower = text.lower()

            if text_lower.startswith("usar ") or text_lower.startswith("cambiar a "):
                parts = text.split(" ", 1)
                target = parts[1].strip() if len(parts) > 1 else ""
                if not SESSION_NAME_RE.match(target):
                    send_text(f"❌ Nombre de sesión inválido: {target}")
                    last_id = save_offset(uid)
                    continue
                if os.path.isdir(os.path.join(BASE, target)):
                    CURRENT = target
                    with open(CURRENT_FILE, "w") as f:
                        f.write(CURRENT)
                    send_text(f"✅ Cambiado a sesión '{target}'")
                else:
                    send_text(f"❌ Sesión '{target}' no existe. Sesiones:\n{format_sessions()}")
                last_id = save_offset(uid)
                continue

            if text_lower in ("listar sesiones", "listar", "sesiones"):
                send_text(f"📋 Sesiones:\n{format_sessions()}")
                last_id = save_offset(uid)
                continue

            if text_lower.startswith("crear sesion ") or text_lower.startswith("crear "):
                parts = text.split(" ", 1)
                target = parts[1].strip() if len(parts) > 1 else ""
                if not SESSION_NAME_RE.match(target):
                    send_text(f"❌ Nombre de sesión inválido: {target}")
                    last_id = save_offset(uid)
                    continue
                path = os.path.join(BASE, target)
                if os.path.exists(path):
                    send_text(f"❌ Sesión '{target}' ya existe")
                else:
                    os.makedirs(os.path.join(path, "inbox"))
                    os.makedirs(os.path.join(path, "outbox"))
                    os.makedirs(os.path.join(path, "files"))
                    CURRENT = target
                    with open(CURRENT_FILE, "w") as f:
                        f.write(CURRENT)
                    send_text(f"✅ Sesión '{target}' creada y activada")
                last_id = save_offset(uid)
                continue

            if text_lower.startswith("cerrar sesion ") or text_lower.startswith("cerrar "):
                parts = text.split(" ", 1)
                target = parts[1].strip() if len(parts) > 1 else CURRENT
                if not target:
                    send_text("❌ No hay sesión activa. Especifica: cerrar sesion <nombre>")
                    last_id = save_offset(uid)
                    continue
                close_session_from_telegram(target)
                last_id = save_offset(uid)
                continue

            if any(x in text_lower for x in ["cuelgo el teléfono", "cuelga", "colgar", "finalizar"]):
                if CURRENT:
                    close_session_from_telegram(CURRENT)
                else:
                    send_text("❌ No hay sesión activa")
                last_id = save_offset(uid)
                continue

            if not CURRENT:
                send_text("❌ No hay sesión activa. Usa: usar <nombre>")
                send_text("Sesiones:\n" + format_sessions())
                last_id = save_offset(uid)
                continue

            file_note = ""
            doc = msg.get("document") or {}
            photo = msg.get("photo") or []
            file_id = doc.get("file_id") or (photo[-1]["file_id"] if photo else "")
            if file_id and not is_edit:
                file_path = download_file(file_id)
                files_dir = os.path.join(BASE, CURRENT, "files")
                os.makedirs(files_dir, exist_ok=True)
                fname = doc.get("file_name", f"photo-{str(uuid.uuid4())[:8]}.jpg")
                dest = os.path.join(files_dir, fname)
                os.rename(file_path, dest)
                file_note = f"[📎 {fname}]"
                send_text(f"📎 Archivo guardado en sesión '{CURRENT}': {fname}")

            if not text and not file_id:
                last_id = save_offset(uid)
                continue

            prefix = "✏️ *mensaje editado*: " if is_edit else ""
            if file_note:
                text = f"{file_note}\n{text}" if text else file_note
            text = prefix + text

            write_to_inbox(CURRENT, text)
            last_id = save_offset(uid)

    except Exception as e:
        print(f"[tg-bot] Error: {e}", file=sys.stderr)
        time.sleep(5)
