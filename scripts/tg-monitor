#!/usr/bin/env python3
"""Monitor inbox using inotify (event-driven, no polling)."""
import atexit, os, signal, subprocess, sys

BASE = os.environ.get("TG_RELAY_SESSIONS") or os.path.expanduser("~/Proyectos/tg-relay/sessions")
CURRENT_FILE = "/tmp/tg-current-session"
ALERT_FILE = "/tmp/tg-new-msg"

def get_session():
    if len(sys.argv) > 1:
        return sys.argv[1]
    if os.path.exists(CURRENT_FILE):
        with open(CURRENT_FILE) as f:
            return f.read().strip()
    return ""

session = get_session()
if not session:
    sys.exit(1)

inbox = os.path.join(BASE, session, "inbox")
os.makedirs(inbox, exist_ok=True)

proc = subprocess.Popen(
    ["inotifywait", "-m", "-e", "create", "--format", "%f", inbox],
    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
)

atexit.register(proc.terminate)
signal.signal(signal.SIGTERM, lambda *_: proc.terminate() or sys.exit(0))

for line in proc.stdout:
    fname = line.strip()
    if fname.endswith(".txt"):
        with open(ALERT_FILE, "w") as f:
            f.write(session)
