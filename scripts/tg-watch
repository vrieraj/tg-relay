#!/usr/bin/env bash
# Persistent inotify watcher — monitors .new signal from tg-bot
# Usage: tg-watch [session]
set -e

SESSION="${1:-}"
if [ -z "$SESSION" ]; then
    if [ -f /tmp/tg-current-session ]; then
        SESSION=$(cat /tmp/tg-current-session)
    else
        echo "Usage: tg-watch [session]" >&2
        exit 1
    fi
fi

BASE="${TG_RELAY_SESSIONS:-$HOME/Proyectos/tg-relay/sessions}"
SESSION_DIR="$BASE/$SESSION"
SIGNAL_FILE="/tmp/tg-new-msg"
mkdir -p "$SESSION_DIR/inbox"

inotifywait -m -e close_write --format '%f' "$SESSION_DIR" 2>/dev/null | while read file; do
    if [ "$file" = ".new" ]; then
        echo "$(date '+%H:%M:%S') [Telegram] Nuevo mensaje en sesion '$SESSION'" >> /tmp/tg-watch.log
        echo "$SESSION" > "$SIGNAL_FILE"
    fi
done
