#!/usr/bin/env python3
"""Read new messages from a session's inbox."""
import os, re, sys

BASE = os.environ.get("TG_RELAY_SESSIONS") or os.path.expanduser("~/Proyectos/tg-relay/sessions")
CURRENT_FILE = "/tmp/tg-current-session"
SESSION_NAME_RE = re.compile(r'^[a-zA-Z0-9_-]+$')

def get_session():
    if len(sys.argv) > 1:
        return sys.argv[1]
    if os.path.exists(CURRENT_FILE):
        with open(CURRENT_FILE) as f:
            return f.read().strip()
    return ""

session = get_session()
if not session:
    print("No session specified and none active.", file=sys.stderr)
    sys.exit(1)

if not SESSION_NAME_RE.match(session):
    print(f"Invalid session name: {session}", file=sys.stderr)
    sys.exit(1)

inbox = os.path.join(BASE, session, "inbox")
if not os.path.isdir(inbox):
    print(f"Session '{session}' not found", file=sys.stderr)
    sys.exit(1)

messages = []
for fname in sorted(os.listdir(inbox)):
    if not fname.endswith(".txt"):
        continue
    fpath = os.path.join(inbox, fname)
    with open(fpath) as f:
        content = f.read().strip()
    os.remove(fpath)
    messages.append(content)

if messages:
    print("\n---\n".join(messages))
