#!/usr/bin/env python3
"""Read new messages from a session's inbox."""
import os, re, sys
from tg_shared import get_base_dir, get_current_session, drain_inbox

BASE = get_base_dir()
SESSION_NAME_RE = re.compile(r'^[a-zA-Z0-9_-]+$')

def get_session():
    if len(sys.argv) > 1:
        return sys.argv[1]
    return get_current_session()

session = get_session()
if not session:
    print("No session specified and none active.", file=sys.stderr)
    sys.exit(1)

if not SESSION_NAME_RE.match(session):
    print(f"Invalid session name: {session}", file=sys.stderr)
    sys.exit(1)

inbox = os.path.join(BASE, session, "inbox")
if not os.path.isdir(inbox):
    print(f"Session '{session}' not found", file=sys.stderr)
    sys.exit(1)

messages = drain_inbox(inbox)

if messages:
    print("\n---\n".join(messages))