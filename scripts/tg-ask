#!/usr/bin/env python3
"""Ask the user a question via Telegram and wait for a yes/no answer.
Usage: tg-ask [session] "Question text"
Returns 0 if user says yes, 1 if no, 2 if timeout/error."""
import os, sys, time, uuid
import requests
import subprocess
from tg_shared import get_base_dir, get_current_session

BASE = get_base_dir()
TIMEOUT = int(os.environ.get("TG_ASK_TIMEOUT", "300"))

def parse_session_and_question():
    if len(sys.argv) > 2:
        return sys.argv[1], " ".join(sys.argv[2:])
    return get_current_session(), " ".join(sys.argv[1:])

session, question = parse_session_and_question()
if not session:
    print("No session specified", file=sys.stderr)
    sys.exit(2)
if not question:
    print("No question specified", file=sys.stderr)
    sys.exit(2)

out_id = str(uuid.uuid4())[:8]
out_file = os.path.join(BASE, session, "outbox", f"{out_id}.txt")
os.makedirs(os.path.dirname(out_file), exist_ok=True)
with open(out_file, "w") as f:
    f.write(f"❓ {question}\n\nResponde 'si' para confirmar o 'no' para cancelar.")

inbox = os.path.join(BASE, session, "inbox")
os.makedirs(inbox, exist_ok=True)

deadline = time.time() + TIMEOUT

while time.time() < deadline:
    remaining = int(deadline - time.time())
    proc = subprocess.run(
        ["inotifywait", "-q", "-e", "create", "--format", "%f", "--timeout", str(remaining), inbox],
        capture_output=True, text=True
    )
    if proc.returncode != 0:
        with open(out_file, "w") as f:
            f.write("⏱️ Tiempo de espera agotado para la pregunta.")
        sys.exit(2)

    answer = ""
    for fname in sorted(os.listdir(inbox)):
        if not fname.endswith(".txt"):
            continue
        fpath = os.path.join(inbox, fname)
        with open(fpath) as f:
            content = f.read().strip()
        os.remove(fpath)
        answer = content.lower()

    if "si" in answer:
        with open(out_file, "w") as f:
            f.write("✅ Autorizado.")
        sys.exit(0)
    elif "no" in answer:
        with open(out_file, "w") as f:
            f.write("❌ Denegado.")
        sys.exit(1)